{
  "name": "ganzu",
  "version": "0.0.9",
  "type": "module",
  "description": "Organized configuration",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run t -- --run",
    "t": "vitest --typecheck",
    "build": "tsup",
    "clean": "rimraf dist",
    "publish-package": "npm run build && npm publish --access public",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mythmon/ganzu.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mythmon/ganzu/issues"
  },
  "homepage": "https://github.com/mythmon/ganzu#readme",
  "devDependencies": {
    "@ganzu/config-eslint": "file:../config-eslint",
    "@ganzu/config-prettier": "file:../config-prettier",
    "@ganzu/config-tsc": "file:../config-tsc",
    "@tsconfig/node-lts": "^22.0.1",
    "@tsconfig/node-ts": "^23.6.1",
    "@tsconfig/recommended": "^1.0.8",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.13.13",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "3.0.9"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "zod": "^3.24.2"
  }
}
