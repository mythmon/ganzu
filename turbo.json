{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "^test"]
    },
    "publish-package": {
      "dependsOn": ["build", "test", "typecheck", "format:check"],
      "env": ["NODE_AUTH_TOKEN"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": []
    },
    "ci": {
      "dependsOn": ["format:check", "build", "test", "typecheck"]
    }
  }
}
